# Copy this file to .env or configure these values in your IDE/system environment.
# Do not commit real passwords, tokens, or private host addresses.

HMDP_DATASOURCE_URL=jdbc:mysql://localhost:3306/hmdp?useSSL=false&serverTimezone=UTC
HMDP_DATASOURCE_USERNAME=hmdp_user
HMDP_DATASOURCE_PASSWORD=change-me

HMDP_REDIS_HOST=localhost
HMDP_REDIS_PORT=6379
HMDP_REDIS_PASSWORD=change-me

HMDP_RABBITMQ_HOST=localhost
HMDP_RABBITMQ_PORT=5672
HMDP_RABBITMQ_USERNAME=hmdp
HMDP_RABBITMQ_PASSWORD=hmdp_mq_2026
HMDP_RABBITMQ_VIRTUAL_HOST=/hmdp

HMDP_REDISSON_NODE1_ADDRESS=redis://localhost:6379
HMDP_REDISSON_NODE2_ADDRESS=redis://localhost:6381
HMDP_REDISSON_NODE3_ADDRESS=redis://localhost:6382
HMDP_REDISSON_PASSWORD=change-me

# Optional: absolute Nginx frontend imgs directory, using forward slashes on Windows.
# Example: F:/nginx/html/hmdp/imgs/
HMDP_IMAGE_UPLOAD_DIR=

# SMS: leave mock for local development and automated tests.
# Personal SMS verification: aliyun-pnvs. Ordinary enterprise SMS: aliyun.
HMDP_SMS_PROVIDER=mock
HMDP_SMS_SEND_INTERVAL_SECONDS=60
HMDP_SMS_MAX_SENDS_PER_DAY=10
HMDP_SMS_IP_MAX_COUNT=10
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
HMDP_SMS_ALIYUN_SIGN_NAME=
HMDP_SMS_ALIYUN_TEMPLATE_CODE=
HMDP_SMS_ALIYUN_CODE_PARAM_NAME=code

# Personal SMS verification: use the paired signature/template from the PNVS console.
HMDP_SMS_PNVS_SIGN_NAME=
HMDP_SMS_PNVS_TEMPLATE_CODE=
HMDP_SMS_PNVS_CODE_PARAM_NAME=code
HMDP_SMS_PNVS_MINUTES_PARAM_NAME=min
